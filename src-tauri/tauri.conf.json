{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "测量学局劲工具",
  "version": "0.1.0",
  "identifier": "com.jngkzbird.survey-jujin",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "测量学局劲工具",
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "preventOverflow": true,
        "resizable": true,
        "dragDropEnabled": false,
        "decorations": false,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
